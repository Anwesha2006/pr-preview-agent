# Copy to .env and fill in local credentials. Never commit .env.
WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_INSTALLATION_ID=replace-with-installation-id
GITHUB_PRIVATE_KEY_PATH=secrets/github-app-private-key.pem
GEMINI_API_KEY=replace-with-gemini-api-key

# Redis URL used by both Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0
